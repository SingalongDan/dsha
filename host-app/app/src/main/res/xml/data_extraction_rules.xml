<?xml version="1.0" encoding="utf-8"?>
<!-- API 33+ 的数据提取规则：全面禁止（与 allowBackup=false 一致）。
     应用内含 API Key 与完整会话日志，不应随备份/迁移离开设备。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
